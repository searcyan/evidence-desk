# 复制为 backend/.env 后填写；也可运行 scripts/set-keys.ps1 交互式写入。
# 密钥只从环境变量读取，不要写进 settings.yaml、代码或提交。

# 研究模型（settings.yaml 中 ark-flash 档使用）：任意 OpenAI 兼容端点
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=

# 评委模型（judge 档）；默认研究模型档 minimax-m3 也使用这组端点
JUDGE_BASE_URL=
JUDGE_API_KEY=

# 检索服务
TAVILY_API_KEY=
EXA_API_KEY=

# 服务与运行时
NEWSAGENT_DATA_DIR=../data
NEWSAGENT_HOST=127.0.0.1
NEWSAGENT_PORT=8000
NEWSAGENT_MAX_CONCURRENT_RUNS=2
NEWSAGENT_MAX_LLM_INFLIGHT=4
NEWSAGENT_CACHE_HOURS=24
CLARIFICATION_TIMEOUT_SECONDS=1800
LOG_LEVEL=INFO
