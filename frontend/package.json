{
  "name": "evidence-desk-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "contract:schema": "ts-json-schema-generator --path src/api/types.ts --type \"*\" --tsconfig tsconfig.app.json --no-type-check -o ../contracts/schema.json",
    "contract:fixtures": "tsx scripts/export-fixtures.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "tailwindcss": "^4.3.5",
    "ts-json-schema-generator": "^2.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
